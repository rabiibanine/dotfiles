# Copy to .env (cp .env.example .env) and CHANGE THE PLACEHOLDER VALUES.
# .env is gitignored; this example file is the tracked one.

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# --- Oracle Free ---
ORACLE_PASSWORD=change-me
ORACLE_APP_USER=appuser
ORACLE_APP_USER_PASSWORD=change-me

